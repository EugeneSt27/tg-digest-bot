# Доступные значения: gemini | openai
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

GEMINI_API_KEY=gemini_token
OPENAI_API_KEY=your_openrouter_or_proxyapi_key_here
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Для OpenRouter: https://openrouter.ai/api/v1
# Для ProxyAPI:   https://api.proxyapi.ru/openai/v1
# Для OpenAI:     оставьте пустым или https://api.openai.com/v1

# telegram
# Токен бота: TELEGRAM_BOT_TOKEN_<PROFILE>
# Если токен профиля не задан, используется общий TELEGRAM_BOT_TOKEN.
TELEGRAM_BOT_TOKEN=token
TELEGRAM_BOT_TOKEN_AI=token
TELEGRAM_BOT_TOKEN_SPB=token

# Дополнительный получатель (админ или канал): TELEGRAM_CHAT_ID_<PROFILE>.
TELEGRAM_CHAT_ID=chat_id
TELEGRAM_CHAT_ID_AI=chat_id
TELEGRAM_CHAT_ID_SPB=chat_id
